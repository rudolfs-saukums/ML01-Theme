<?xml version="1.0" encoding="UTF-8"?>

<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Widget:etc/widget.xsd">
    <widget id="page_list_widget" class="MageMastery\PageListWidget\Block\Page\Widget\PageList">
        <label translate="true">Custom widget</label>
        <description translate="true">The goal of this task is to create a new widget that provides the possibility to place a list of CMS pages where necessary.</description>
        <parameters>
            <parameter name="title" xsi:type="text" required="false">
                <label>Title</label>
            </parameter>
            <parameter name="display_mode" xsi:type="select" required="true">
                <label>Display mode</label>
                <options>
                    <option name="all_pages" value="all_pages" selected="true">
                        <label>All Pages</label>
                    </option>
                    <option name="selected_pages" value="selected_pages">
                        <label>Selected Pages</label>
                    </option>
                </options>
            </parameter>
            <parameter name="selected_pages" xsi:type="multiselect" required="false" source_model="MageMastery\PageListWidget\Model\Config\Source\CmsPageDropdown">
                <label>Selected Pages</label>
                <depends>
                    <parameter name="display_mode" value="selected_pages"/>
                </depends>
            </parameter>
        </parameters>
    </widget>
</widgets>

