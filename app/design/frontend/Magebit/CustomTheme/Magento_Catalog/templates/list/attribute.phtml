/** @var $block \Magebit\Orders\Block\Product\View\Description */

$filteredAttributes = $block->getFilteredAttributes();
?>

<?php if (!empty($filteredAttributes)): ?>
    <div class="product-attributes">
        <ul>
            <?php foreach ($filteredAttributes as $attribute): ?>
                <li>
                    <strong><?= $block->escapeHtml($attribute['label']) ?>:</strong>
                    <?= $block->escapeHtml($attribute['value']) ?>
                </li>
            <?php endforeach; ?>
        </ul>
        <h4>
            <?php
            $product = $block->getProduct();
            if ($product) {
                $shortDescription = $product->getShortDescription();
                echo $block->escapeHtml(strip_tags($shortDescription));
            }
            ?>
        </h4>
    </div>
<?php endif; ?>
